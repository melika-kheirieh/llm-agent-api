# --------------------------------------------------
# LLM Provider Selection
# --------------------------------------------------

# Possible values: ollama | openai
LLM_PROVIDER=ollama


# --------------------------------------------------
# Ollama (local, default)
# --------------------------------------------------

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma


# --------------------------------------------------
# OpenAI (optional)
# --------------------------------------------------

# Uncomment and set when using OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Optional: custom endpoint (OpenRouter, proxy, Azure, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1


# --------------------------------------------------
# Database
# --------------------------------------------------

# Local default: SQLite. Production / Compose: PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./app.db
# DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent

# Timeout for each model call and each tool call (seconds), independently.
# Not a whole-run cap. Persistence is not covered by this value.
LLM_TIMEOUT_SECONDS=60

# Router: keyword (default, no extra model call) | llm (structured routing).
# Changing this does not change the HTTP chat contract.
ROUTER_MODE=keyword
